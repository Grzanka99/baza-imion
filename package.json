{
  "name": "baza-imion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "tsc -p tsconfig.node.json && vp run -r build",
    "start": "vp run @baza-imion/server#start",
    "ready": "vp check && vp run -r build",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@baza-imion/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
