{
  "name": "baza-imion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run dev:api & vp dev",
    "dev:api": "node --env-file-if-exists=.env --import ./server/ts-imports.ts --watch server/index.ts",
    "build": "tsc -b && vp build",
    "start": "node --env-file-if-exists=.env --import ./server/ts-imports.ts server/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
